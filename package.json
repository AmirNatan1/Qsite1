{
  "name": "quantum-hub-qsite1",
  "version": "0.1.0-phase-1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "unifont": "0.7.4"
  },
  "scripts": {
    "stage:phase4-media": "node scripts/stage-phase4-media.mjs && node scripts/stage-phase4r2-runtime-media.mjs",
    "dev": "npm run stage:phase4-media && astro dev",
    "check": "npm run stage:phase4-media && astro check && node --test tests/phase1-publication.test.mjs tests/phase4r2-runtime.test.mjs tests/phase5a-supporting-routes.test.mjs tests/phase5a-preproduction-tooling.test.mjs && node scripts/verify-phase4-source.mjs && node scripts/verify-phase5a-supporting-routes.mjs",
    "test": "node --test tests/phase1-publication.test.mjs tests/phase4r2-runtime.test.mjs tests/phase5a-supporting-routes.test.mjs tests/phase5a-preproduction-tooling.test.mjs",
    "build": "node scripts/run-phase4-build.mjs",
    "build:phase4r2-final": "node scripts/run-phase4r2-final-build.mjs",
    "qa:browser": "node scripts/qa-phase4-browser.mjs --server-mode astro-preview --base-url http://127.0.0.1:4334",
    "qa:visual": "node scripts/create-phase1-contact-sheets.mjs",
    "qa:phase1": "node --test tests/phase1-publication.test.mjs",
    "qa:phase4": "npm run check && npm run build && npm run qa:browser",
    "qa:phase5a-routes": "node scripts/verify-phase5a-supporting-routes.mjs",
    "qa:evidence": "npm run qa:evidence:phase4",
    "qa:evidence:phase2b": "node scripts/capture-phase2b-evidence.mjs",
    "qa:evidence:phase4": "node scripts/capture-phase4-evidence.mjs --url http://127.0.0.1:4322/ --output artifacts/evidence/phase-4/review",
    "phase4r2:preflight": "node scripts/phase4r2-production.mjs preflight",
    "phase4r2:status": "node scripts/phase4r2-production.mjs status",
    "check:phase0-evidence": "node --test tests/phase0.test.mjs && node scripts/verify-creative-assets.mjs && node scripts/verify-phase0-3d-repair.mjs && node scripts/verify-phase0-3d-repair-v2-assets.mjs && node scripts/verify-phase0-3d-repair-v2-layout.mjs && node scripts/verify-phase0-3d-repair-v3-layout.mjs && node scripts/verify-phase0-3d-repair-v3-assets.mjs && node scripts/verify-phase0-4r-crt-layout.mjs && node scripts/verify-phase0-4r-crt-assets.mjs --final",
    "capture:phase03": "node scripts/capture-phase03-browser-matrix.mjs",
    "capture:phase04": "node scripts/capture-phase04-browser-matrix.mjs",
    "prepare:phase04-browser": "node scripts/finalize-phase04-browser-evidence.mjs --prepare",
    "finalize:phase04-browser": "node scripts/finalize-phase04-browser-evidence.mjs --complete",
    "check:phase04-browser": "node scripts/finalize-phase04-browser-evidence.mjs --check",
    "capture:phase04r": "node scripts/capture-phase04r-browser-matrix.mjs",
    "prepare:phase04r-browser": "node scripts/finalize-phase04r-browser-evidence.mjs --prepare",
    "finalize:phase04r-browser": "node scripts/finalize-phase04r-browser-evidence.mjs --complete",
    "check:phase04r-browser": "node scripts/finalize-phase04r-browser-evidence.mjs --check",
    "preview": "astro preview",
    "prototype": "node scripts/serve-prototype.mjs"
  },
  "dependencies": {
    "astro": "7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "axe-core": "4.10.3",
    "playwright-core": "1.62.1",
    "sharp": "0.35.3",
    "typescript": "5.9.3"
  }
}
