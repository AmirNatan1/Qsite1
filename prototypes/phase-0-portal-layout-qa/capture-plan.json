  "capture": {
    "rawDirectory": "artifacts/evidence/phase-0-3d-repair-v2/captures/raw",
    "normalizedDirectory": "artifacts/evidence/phase-0-3d-repair-v2/captures/normalized",
    "rawFilenameTemplate": "{idPrefix}--{viewportId}.jpg",
    "normalizedFilenameTemplate": "{idPrefix}--{viewportId}.png",
    "fullPage": true,
    "omitBackground": false,
    "devicePixelRatioPolicy": "record the actual browser DPR; do not claim or require control",
    "browserRasterPolicy": "record the actual full-page JPEG dimensions; the in-app browser raster is not assumed to be CSS dimensions multiplied by DPR",
    "maximumRenderedWidth": 1200,
    "normalization": "crop the rendered outer-frame bounds from top-left 0,0; for captureScale 1 write a same-size PNG without resampling, and for captureScale below 1 resample the crop to the requested CSS viewport with Lanczos; preserve the raw and normalized SHA-256 values and the complete scale/crop lineage",
    "normalizationMethod": "top-left-rendered-frame-crop-lanczos-when-scaled",
    "stabilization": {
      "method": "exact-byte-modal-winner",
      "successiveFullPageJpegsPerVisualCase": 11,
      "winnerSelection": "save only the unique JPEG byte sequence with the highest frequency; a tied mode is invalid",
      "minimumWinnerVotes": 7,
      "timingClaim": "none; successive captures may alternate compositor states despite readiness and paint barriers"
    }
  },
  "requiredAssertions": [
    "report.pass is true",
    "contract SHA-256 matches the repository source",
    "no page or route horizontal overflow",
    "no measured content collisions",
    "every hero state and every reduced-portal stress state clears source-pixel-derived Field Unit and spiral-cable keepouts by at least 16 CSS pixels; 200 percent, long-copy and reduced-portal states displace the full decorative scene outside the clipped viewport",
    "expected H1 line-count range passes",
    "all visible audience buttons are at least 44 by 44 CSS pixels",
    "programmatic keyboard focus exposes an outline of at least 2 CSS pixels",
    "the sole audience divider clears every glyph bound by at least 12 reference pixels",
    "reference-mode portal anchors differ by no more than 3 CSS pixels",
    "every live DOM-owned portal case uses a text-free scene; exact 16:10 cases retain JSON anchor checks while the separate physical/DOM/overlay sheet proves crossover alignment",
