---
import { sparkProgramme } from "../../../content";

const conditions = [
  ["MVP+ technology", "A working capability that can move beyond a concept-only conversation."],
  ["Clear industrial use case", "A credible connection between what the technology does and an operational need."],
  ["Deployable team", "People available to prepare, support and learn from a structured field test."],
  ["Measurable value", "A practical view of what evidence would make the POC informative."],
  ["Organisational readiness", "Willingness to work with a large organisation, its processes and its operating environment."],
] as const;

const fitLines = [
  ["Relevant industrial access", "Connections shaped around an identified need."],
  ["Use-case design", "A clearer link between the capability, user and operating problem."],
  ["POC design", "A bounded plan for what to test, where and why."],
  ["Domain feedback", "Input grounded in the operating environment."],
  ["Real operating environments", "Conditions that reveal practical constraints an abstract demo cannot."],
  ["Evidence-based next step", "A structured record for what follows the test."],
] as const;

const startupRoute = [
  ["Readiness", "Establish the technology, team and use case are ready for an industrial conversation."],
  ["Relevance", "Connect the capability to a real operational need and operating context."],
  ["Design", "Define the POC question, environment and evidence criteria with the parties involved."],
  ["Field", "Run a bounded test and observe how the technology behaves under meaningful conditions."],
  ["Evidence", "Use what was learned to define an appropriate next step."],
] as const;
---

<article class="semantic-shell" data-route-production="for-startups" data-route-architecture="phase-7a-semantic-shell" aria-labelledby="startup-title">
  <header class="semantic-shell__hero">
    <p class="semantic-kicker">For startups</p>
    <div class="semantic-shell__hero-copy">
      <h1 id="startup-title">Bring your technology into the real world.</h1>
      <p class="semantic-lead">Move from a promising capability to a relevant industrial question, a structured POC and evidence grounded in operating conditions.</p>
      <a href="/contact/#for-startups">Introduce your technology</a>
    </div>
  </header>

  <section class="semantic-section" aria-labelledby="startup-readiness-title">
    <p class="semantic-kicker">Readiness</p>
    <div class="semantic-section__content">
      <h2 id="startup-readiness-title">Ready means more than interesting.</h2>
      <p class="semantic-lead">A useful industrial test needs a technology, use case and team that can engage with real constraints.</p>
      <dl class="semantic-rows">
        {conditions.map(([title, description]) => <div><dt>{title}</dt><dd>{description}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="semantic-section" aria-labelledby="startup-fit-title">
    <p class="semantic-kicker">What Quantum can provide</p>
    <div class="semantic-section__content">
      <h2 id="startup-fit-title">Context for a better test.</h2>
      <p class="semantic-lead">Quantum connects a technology’s potential to an industrial evidence question.</p>
      <ul class="semantic-rows">
        {fitLines.map(([title, description]) => <li><h3>{title}</h3><p>{description}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="semantic-section" aria-labelledby="startup-route-title">
    <p class="semantic-kicker">Startup route</p>
    <div class="semantic-section__content">
      <h2 id="startup-route-title">From readiness to evidence.</h2>
      <p class="semantic-lead">The route narrows possibility into a relevant industrial test.</p>
      <ol class="semantic-rows" aria-label="Five-stage startup route">
        {startupRoute.map(([title, description]) => <li><h3>{title}</h3><p>{description}</p></li>)}
      </ol>
      <div class="semantic-copy">
        <p class="semantic-status">SPARK pathway</p>
        <h3>{sparkProgramme.name}</h3>
        <p>{sparkProgramme.summary}</p>
        <strong>{sparkProgramme.status}</strong>
        <p>The public pathway is not accepting applications. No future date or alternative registration route is being offered here.</p>
        <p class="semantic-note"><strong>Participation note:</strong> Quantum develops relevant opportunities and structured POCs; participation does not guarantee a pilot, procurement agreement or investment.</p>
      </div>
    </div>
  </section>

  <footer class="semantic-shell__release">
    <p class="semantic-kicker">Technology introduction</p>
    <div>
      <h2>Introduce the technology.</h2>
      <p>Start with the capability, industrial use case and the conditions you are ready to test.</p>
      <nav class="semantic-inline-links" aria-label="Startup next steps">
        <a href="/contact/#for-startups">Choose the startup path</a>
        <a href="/spark/">Explore SPARK</a>
      </nav>
    </div>
  </footer>
</article>
