---
import { maradinProofRecord, publicProofRecords } from "../../../content";

if (publicProofRecords.length !== 1) {
  throw new Error("The public Proof overview must contain exactly one approved record.");
}

const proofStages = [
  ["Define the condition", "State the operating need and the uncertainty the test should address."],
  ["Match the technology", "Assess relevance and readiness before entering the field."],
  ["Design the test", "Select conditions and observations that make the POC informative."],
  ["Record the evidence", "Separate what was observed from the questions the POC did not answer."],
] as const;
---

<article class="semantic-shell" data-route-production="proof" data-route-architecture="phase-7a-semantic-shell" aria-labelledby="proof-title">
  <header class="semantic-shell__hero">
    <p class="semantic-kicker">Proof</p>
    <div class="semantic-shell__hero-copy">
      <h1 id="proof-title">Evidence before scale.</h1>
      <p class="semantic-lead">A POC should reduce a specific uncertainty. Quantum connects the original need, field conditions and evidence in one structured record.</p>
    </div>
  </header>

  <section class="semantic-section" aria-labelledby="proof-record-title">
    <p class="semantic-kicker">Only public field record</p>
    <div class="semantic-section__content semantic-copy">
      <h2 id="proof-record-title">{maradinProofRecord.title}</h2>
      <p>{maradinProofRecord.summary}</p>
      <a href="/pocs/maradin/">Open the field record</a>
    </div>
  </section>

  <section class="semantic-section" aria-labelledby="proof-philosophy-title">
    <p class="semantic-kicker">Evidence philosophy</p>
    <div class="semantic-section__content semantic-copy">
      <h2 id="proof-philosophy-title">Test the question that matters.</h2>
      <p>A convincing demonstration is not automatically useful evidence. Quantum starts by defining the operational question, the environment that gives it meaning and the observations needed to understand what should happen next.</p>
      <p>Technology fit is assessed before the test. The POC is then bounded so its design stays connected to the operating question, relevant conditions and evidence needed for a next-step decision.</p>
      <p>Evidence is reported with its context and limits intact, giving the parties a clearer basis for the next-step decision.</p>
    </div>
  </section>

  <section class="semantic-section" aria-labelledby="proof-process-title">
    <p class="semantic-kicker">Structured POC</p>
    <div class="semantic-section__content">
      <h2 id="proof-process-title">From condition to evidence.</h2>
      <p class="semantic-lead">A useful field record keeps the challenge, technology, test design, execution and evidence distinct.</p>
      <ol class="semantic-rows" aria-label="Structured POC discipline">
        {proofStages.map(([stage, detail]) => <li><h3>{stage}</h3><p>{detail}</p></li>)}
      </ol>
    </div>
  </section>

  <footer class="semantic-shell__release">
    <p class="semantic-kicker">Next question</p>
    <div>
      <h2>Define what the test must answer.</h2>
      <p>Start with the uncertainty that matters in the operating environment.</p>
      <nav class="semantic-inline-links" aria-label="Proof starting contexts">
        <a href="/contact/#for-industry">Bring an industrial challenge</a>
        <a href="/contact/#for-startups">Introduce a technology</a>
      </nav>
    </div>
  </footer>
</article>
