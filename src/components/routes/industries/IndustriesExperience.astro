---
import { PUBLIC_INDUSTRIES } from "../../../content";

const descriptions: Record<(typeof PUBLIC_INDUSTRIES)[number]["id"], string> = {
  "automotive-mobility": "Vehicle systems, mobility operations and human-machine interaction create demanding contexts for field evidence.",
  "logistics-supply-chain": "Movement, visibility and coordination must be understood across real workflows and physical infrastructure.",
  "advanced-manufacturing": "Production environments bring equipment, people, data and process constraints into the same test.",
  "energy-infrastructure": "Energy systems and physical assets require relevance to be assessed inside operating and implementation conditions.",
};

const technologyCategories = [
  "AI and data",
  "robotics and autonomy",
  "sensors and computer vision",
  "cybersecurity",
  "advanced materials",
  "energy systems",
  "enterprise software",
] as const;
---

<article class="semantic-shell" data-route-production="industries" data-route-architecture="phase-7a-semantic-shell" aria-labelledby="industries-title">
  <header class="semantic-shell__hero">
    <p class="semantic-kicker">Industrial domains</p>
    <div class="semantic-shell__hero-copy">
      <h1 id="industries-title">Industry is where relevance is tested.</h1>
      <p class="semantic-lead">A technology becomes meaningful when it meets the systems, constraints and operating conditions of a real domain.</p>
    </div>
  </header>

  <section class="semantic-section" aria-labelledby="industries-domains-title">
    <p class="semantic-kicker">Four domains</p>
    <div class="semantic-section__content">
      <h2 id="industries-domains-title">Different fields. The same evidence discipline.</h2>
      <p class="semantic-lead">Each domain changes the question, environment and conditions a useful POC must address.</p>
      <ol class="semantic-rows">
        {PUBLIC_INDUSTRIES.map((industry) => (
          <li><h3>{industry.name}</h3><p>{descriptions[industry.id]}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="semantic-section" aria-labelledby="industries-perspectives-title">
    <p class="semantic-kicker">Technology perspectives</p>
    <div class="semantic-section__content">
      <h2 id="industries-perspectives-title">Capabilities can cross domain lines.</h2>
      <p class="semantic-lead">Relevant technologies may cut across multiple industrial environments. Their fit is determined within the specific operating context.</p>
      <ul class="semantic-rows" aria-label="Technology categories">
        {technologyCategories.map((category) => <li><strong>{category}</strong><span>Assessed inside the operating context.</span></li>)}
      </ul>
    </div>
  </section>

  <section class="semantic-section" aria-labelledby="industries-method-title">
    <p class="semantic-kicker">Method</p>
    <div class="semantic-section__content semantic-copy">
      <h2 id="industries-method-title">Design around the field.</h2>
      <p>Quantum begins with the need and works outward: stakeholders, environment, constraints, technology fit and the evidence required. The test is shaped around that whole system rather than a generic demo.</p>
    </div>
  </section>

  <footer class="semantic-shell__release">
    <p class="semantic-kicker">Industry route</p>
    <div>
      <h2>Bring the domain context.</h2>
      <p>A useful conversation begins with the operating challenge, not a preselected solution.</p>
      <a href="/contact/#for-industry">Start with the challenge</a>
    </div>
  </footer>
</article>
