---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  displayWidth?: number;
  displayHeight?: number;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  displayWidth = width,
  displayHeight = height,
  loading = "lazy",
  fetchpriority,
  class: className = "",
} = Astro.props;
---

<figure class:list={["editorial-figure", className]}>
  <img {src} {alt} width={displayWidth} height={displayHeight} {loading} {fetchpriority} decoding="async" />
  <figcaption><slot /></figcaption>
</figure>

<style>
  .editorial-figure { margin: 0; }
  .editorial-figure img { display: block; width: 100%; height: auto; }
  .editorial-figure figcaption {
    margin-block-start: 0.65rem;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    line-height: 1.5;
  }
</style>
