<article
  class="recovery-field"
  data-route-production="404"
  data-route-architecture="misregistered-recovery-field"
  data-route-motion="static"
  aria-labelledby="not-found-title"
>
  <section class="recovery-act" data-route-act="recovery" data-route-region="recovery">
    <div class="recovery-copy">
      <p class="recovery-status">Error / Page not found</p>
      <h1 id="not-found-title" aria-label="The requested route is out of alignment.">
        <span aria-hidden="true">The requested</span>
        <span aria-hidden="true">route is out of</span>
        <span aria-hidden="true">alignment.</span>
      </h1>
      <a class="recovery-link" href="/">Home <span aria-hidden="true">&#8592;</span></a>
    </div>

    <div class="recovery-plane" data-route-geometry="misregistered-plane" aria-hidden="true">
      <span>404</span>
    </div>
  </section>
</article>
