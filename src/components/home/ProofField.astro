---
interface Media {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  title: string;
  summary: string;
  execution: string;
  openingMedia: Media;
  climaxMedia: Media;
}

const { title, summary, execution, openingMedia, climaxMedia } = Astro.props;
---

<section
  id="proof"
  class="operating-chapter proof-field"
  aria-labelledby="proof-title"
  data-home-scene="proof"
  data-field-section
>
  <article class="proof-opening" data-evidence-id="proof-opening">
    <img
      src={openingMedia.src}
      alt={openingMedia.alt}
      width={openingMedia.width}
      height={openingMedia.height}
      loading="lazy"
      decoding="async"
    />
    <div class="operating-shell proof-opening__content">
      <p class="field-label">Proof</p>
      <h2 id="proof-title">Evidence before scale.</h2>
      <p>{summary}</p>
    </div>
  </article>

  <article class="proof-climax" data-evidence-id="proof-climax">
    <img
      src={climaxMedia.src}
      alt={climaxMedia.alt}
      width={climaxMedia.width}
      height={climaxMedia.height}
      loading="lazy"
      decoding="async"
    />
    <div class="proof-climax__wash" aria-hidden="true"></div>
    <div class="proof-climax__content">
      <p class="field-label">Real operating environment</p>
      <h3>{title}</h3>
      <p>{execution}</p>
      <a class="field-link" href="/pocs/maradin/">Read the Maradin field record</a>
    </div>
  </article>
</section>
