---
interface Step {
  title: string;
  description: string;
}

interface Props {
  steps: readonly Step[];
}

const { steps } = Astro.props;
---

<section
  id="method"
  class="operating-chapter method-field"
  aria-labelledby="method-title"
  data-home-scene="method"
  data-field-section
  data-method-section
>
  <header class="operating-shell method-field__intro">
    <p class="field-label">From need to decision</p>
    <div>
      <h2 id="method-title">A disciplined route through uncertainty.</h2>
      <p>
        Each stage protects the connection between an operational problem and
        the evidence used to move forward.
      </p>
    </div>
  </header>

  <div class="operating-shell method-field__experience" data-method-experience>
    <div class="method-workpiece" data-method-workpiece aria-hidden="true">
      <span class="method-workpiece__backplane"></span>
      <span class="method-workpiece__jaw method-workpiece__jaw--left"></span>
      <span class="method-workpiece__jaw method-workpiece__jaw--right"></span>
      <span class="method-workpiece__core"></span>
      <span class="method-workpiece__channel method-workpiece__channel--one"></span>
      <span class="method-workpiece__channel method-workpiece__channel--two"></span>
      <span class="method-workpiece__channel method-workpiece__channel--three"></span>
      <span class="method-workpiece__tolerance method-workpiece__tolerance--one"></span>
      <span class="method-workpiece__tolerance method-workpiece__tolerance--two"></span>
      <span class="method-workpiece__tolerance method-workpiece__tolerance--three"></span>
      <span class="method-workpiece__gate"></span>
      <span class="method-workpiece__tested"></span>
      <span class="method-workpiece__edge"></span>
      <span class="method-workpiece__current"></span>
    </div>

    <ol class="method-stages" aria-label="Quantum five-stage method">
      {steps.map((step, index) => (
        <li
          id={`method-${step.title.toLowerCase()}`}
          class="method-stage"
          data-method-stage={index}
          data-evidence-id={`method-${step.title.toLowerCase()}`}
        >
          <span class="method-stage__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
