---
interface Programme {
  name: string;
  summary: string;
  status: string;
}

interface Media {
  src: string;
  width: number;
  height: number;
}

interface Props {
  spark: Programme;
  champ: Programme;
  inheritedMedia: Media;
}

const { spark, champ, inheritedMedia } = Astro.props;
---

<section
  id="programmes"
  class="operating-chapter programme-field"
  aria-labelledby="programmes-title"
  data-home-scene="programmes"
  data-field-section
  data-evidence-id="programmes"
>
  <img
    class="programme-field__proof-crop"
    src={inheritedMedia.src}
    alt=""
    width={inheritedMedia.width}
    height={inheritedMedia.height}
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />
  <div class="programme-field__architecture" aria-hidden="true">
    <span class="programme-field__rear"></span>
    <span class="programme-field__near"></span>
    <span class="programme-field__pier"></span>
    <span class="programme-field__lower"></span>
  </div>

  <div class="operating-shell programme-field__content">
    <header>
      <p class="field-label">Programmes</p>
      <h2 id="programmes-title">Structured paths into the field.</h2>
      <p>
        Programmes create a clear context for industry needs and technologies
        that are ready to be assessed.
      </p>
    </header>

    <div class="programme-chambers">
      <article class="programme-chamber programme-chamber--spark">
        <p class="programme-chamber__meta">Startup pathway</p>
        <h3>{spark.name}</h3>
        <p>{spark.summary}</p>
        <strong>{spark.status}</strong>
      </article>

      <article class="programme-chamber programme-chamber--champ">
        <p class="programme-chamber__meta">Industry context</p>
        <h3>{champ.name}</h3>
        <p>{champ.summary}</p>
        <a class="field-link" href="/for-partners/#champ">For industry</a>
      </article>
    </div>
  </div>
</section>
