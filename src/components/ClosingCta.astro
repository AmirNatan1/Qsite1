---
interface Props {
  id?: string;
  scene?: string;
  eyebrow?: string;
  title: string;
  copy: string;
}

const { id, scene, eyebrow = "next signal", title, copy } = Astro.props;
---

<section {id} class="closing-cta section-shell" aria-labelledby="closing-title" data-home-scene={scene}>
  <div class="closing-cta__inner container" data-scene-layer={scene ? "content" : undefined}>
    <p class="eyebrow">{eyebrow}</p>
    <div class="closing-cta__copy">
      <h2 id="closing-title">{title}</h2>
      <p>{copy}</p>
      <div class="button-row">
        <slot />
      </div>
    </div>
  </div>
</section>
