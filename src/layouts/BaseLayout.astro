---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/tokens.css";
import "../styles/typography.css";
import "../styles/global.css";
import "../styles/navigation.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  bodyClass?: string;
  skipHref?: string;
  skipLabel?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  bodyClass = "",
  skipHref = "#main-content",
  skipLabel = "Skip to content",
} = Astro.props;

const siteName = "Quantum";
const documentTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const canonical = !noindex && Astro.site
  ? new URL(canonicalPath, Astro.site).toString()
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0e1112" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/brand/quantum-icon-color.svg" type="image/svg+xml" />
    <slot name="head" />
    <title>{documentTitle}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href={skipHref}>{skipLabel}</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
