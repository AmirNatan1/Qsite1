---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import PageHero from "../../components/PageHero.astro";
import { maradinProofRecord } from "../../content";
import "../../styles/routes/standard.css";
import "../../styles/routes/proof.css";

const title = "Maradin — Dynamic Ground Projection";
const description =
  "A Quantum field record of Maradin’s MEMS-based laser scanning technology tested for vehicle-to-road visual communication.";

const chapters = [
  { label: "Challenge", title: "The communication need", copy: maradinProofRecord.challenge },
  { label: "Technology", title: "The match", copy: maradinProofRecord.technology },
  { label: "Test design", title: "Conditions that matter", copy: maradinProofRecord.testDesign },
  { label: "Execution", title: "Into the field", copy: maradinProofRecord.execution },
  { label: "Evidence", title: "What the POC produced", copy: maradinProofRecord.evidence },
  { label: "Next step", title: "What followed", copy: maradinProofRecord.nextStep },
] as const;

const maradinPoster = maradinProofRecord.media[0];
const testContactVideo = maradinProofRecord.media[1];
const projectionFrame = maradinProofRecord.media[2];
const realFieldStill = maradinProofRecord.media[3];
if (!maradinPoster || !testContactVideo || !projectionFrame || !realFieldStill) {
  throw new Error("The complete approved Maradin media set is required.");
}
---

<BaseLayout {title} {description} bodyClass="maradin-page">
  <PageHero
    eyebrow="proof / field record"
    title={maradinProofRecord.title}
    intro={maradinProofRecord.summary}
  >
    <div class="record-meta" aria-label="Record context">
      <span>Maradin</span>
      <span>Dynamic ground projection</span>
      <span>Real-world field test</span>
    </div>
  </PageHero>

  <section class="maradin-media section-shell" aria-label="Maradin field media">
    <div class="container maradin-media__grid">
      <video
        controls
        muted
        playsinline
        preload="none"
        poster={maradinPoster.src}
        aria-label={maradinProofRecord.heroMedia.alt}
      >
        <source src={maradinProofRecord.heroMedia.src} type="video/mp4" />
        Your browser does not support the field-test video.
      </video>
      <figure>
        <img
          src={projectionFrame.src}
          alt={projectionFrame.alt}
          width={projectionFrame.width}
          height={projectionFrame.height}
          loading="lazy"
        />
        <figcaption>A projected stop-hand symbol observed on the road surface during field testing.</figcaption>
      </figure>
    </div>
  </section>

  <section class="maradin-support-media section-shell" aria-label="Additional Maradin test media">
    <div class="container maradin-support-media__grid">
      <figure>
        <video
          controls
          muted
          playsinline
          preload="none"
          aria-label={testContactVideo.alt}
        >
          <source src={testContactVideo.src} type="video/mp4" />
          Your browser does not support the field-test video.
        </video>
        <figcaption>Vehicle-mounted testing in the operating environment.</figcaption>
      </figure>
      <figure class="maradin-support-media__portrait">
        <img
          src={realFieldStill.src}
          alt={realFieldStill.alt}
          width={realFieldStill.width}
          height={realFieldStill.height}
          loading="lazy"
        />
        <figcaption>A field-test vehicle documented in the Maradin record.</figcaption>
      </figure>
    </div>
  </section>

  <section class="record-chapters" aria-labelledby="field-record-title">
    <div class="container">
      <div class="editorial-section__intro">
        <p class="eyebrow">field record</p>
        <div>
          <h2 id="field-record-title">Condition, test and evidence.</h2>
          <p>
            The record connects the operating need to the tested conditions, the
            observations produced and what followed.
          </p>
        </div>
      </div>
      <ol class="record-chapter-list">
        {chapters.map((chapter, index) => (
          <li>
            <span class="record-chapter-list__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <p class="meta-label">{chapter.label}</p>
              <h3>{chapter.title}</h3>
            </div>
            <p>{chapter.copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="editorial-section" aria-labelledby="capability-title">
    <div class="container">
      <div class="editorial-section__intro">
        <p class="eyebrow">related capabilities</p>
        <div>
          <h2 id="capability-title">Work around the test.</h2>
          <p>POC design, field execution and evidence synthesis kept the test connected to its operating question.</p>
        </div>
      </div>
      <ul class="label-cloud" aria-label="Related capabilities">
        {maradinProofRecord.relatedCapabilities.map((capability) => <li>{capability}</li>)}
      </ul>
    </div>
  </section>

  <ClosingCta
    title="Start with the evidence question."
    copy="A useful POC is designed around what the operating context needs to reveal."
  >
    <a class="button button--primary" href="/contact/#for-industry" aria-label="Bring an industrial challenge">
      <span class="button__label--full">Bring an industrial challenge</span>
      <span class="button__label--compact" aria-hidden="true">Industry challenge</span>
    </a>
    <a class="button button--secondary" href="/pocs/">Return to Proof</a>
  </ClosingCta>
</BaseLayout>
