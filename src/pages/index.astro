---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClosingCta from "../components/ClosingCta.astro";
import ProcessList from "../components/ProcessList.astro";
import {
  PUBLIC_INDUSTRIES,
  champProgramme,
  maradinProofRecord,
  sparkProgramme,
} from "../content";
import "../styles/routes/home.css";
import "../styles/routes/standard.css";

const title = "Industrial innovation tested in the real world";
const description =
  "Quantum brings industry and technology together to define real needs, test solutions and turn evidence into decisions.";

const processSteps = [
  { title: "Frame", description: "Define the operational problem, owner and success criteria." },
  { title: "Source", description: "Find technologies relevant to the real operating context." },
  { title: "Assess", description: "Evaluate technical, commercial and implementation fit." },
  { title: "Test", description: "Run a structured POC in a real environment." },
  { title: "Decide", description: "Use evidence to determine the next step." },
] as const;

const maradinPoster = maradinProofRecord.media[0];
if (!maradinPoster) throw new Error("The approved Maradin poster is required on Home.");
---

<BaseLayout {title} {description} bodyClass="home-page">
  <section class="home-hero section-shell" aria-labelledby="home-title">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">industrial innovation · herzliya</p>
        <h1 id="home-title">Prove it where it has to work.</h1>
        <p class="hero-support">
          Quantum brings industry and technology together to define real needs,
          test solutions and turn evidence into decisions.
        </p>
        <div class="button-row" aria-label="Choose your route">
          <a class="button button--primary" href="/for-partners/">For industry</a>
          <a class="button button--secondary" href="/for-startups/">For startups</a>
        </div>
      </div>

      <div class="signal-field" aria-hidden="true">
        <span class="signal-field__label">FIELD / 01</span>
        <div class="signal-field__lines"></div>
        <span class="signal-field__point"></span>
        <span class="signal-field__caption">need · test · evidence</span>
      </div>
    </div>
  </section>

  <section class="section-shell audience-section" aria-labelledby="audience-title">
    <div class="container">
      <div class="section-heading section-heading--wide">
        <p class="eyebrow">two ways in</p>
        <h2 id="audience-title">Where do you enter?</h2>
      </div>
      <div class="audience-paths">
        <a class="audience-path" href="/for-partners/">
          <span class="audience-path__index" aria-hidden="true">01</span>
          <span class="audience-path__copy">
            <strong>For industry</strong>
            <span>Bring us an operational challenge.</span>
          </span>
          <span class="text-link" aria-hidden="true">Explore</span>
        </a>
        <a class="audience-path" href="/for-startups/">
          <span class="audience-path__index" aria-hidden="true">02</span>
          <span class="audience-path__copy">
            <strong>For startups</strong>
            <span>Bring us a technology ready to be tested.</span>
          </span>
          <span class="text-link" aria-hidden="true">Explore</span>
        </a>
      </div>
    </div>
  </section>

  <section class="editorial-section" aria-labelledby="industry-model-title">
    <div class="container">
      <div class="editorial-section__intro">
        <p class="eyebrow">built with industry</p>
        <div>
          <h2 id="industry-model-title">Start with the operating reality.</h2>
          <p>
            Quantum works from a defined industrial need. The operating context,
            constraints and success criteria shape which technologies are relevant
            and how a POC should be designed.
          </p>
        </div>
      </div>
      <div class="editorial-copy">
        <p>
          Industry relationships anchor the work in real environments rather than
          abstract technology scouting.
        </p>
        <p>
          Technology is assessed against the challenge, then tested through a
          structured path that produces evidence for a responsible next step.
        </p>
      </div>
    </div>
  </section>

  <section class="editorial-section" aria-labelledby="process-title">
    <div class="container">
      <div class="editorial-section__intro">
        <p class="eyebrow">from need to decision</p>
        <div>
          <h2 id="process-title">A disciplined route through uncertainty.</h2>
          <p>Each stage protects the connection between an operational problem and the evidence used to move forward.</p>
        </div>
      </div>
      <ProcessList steps={processSteps} label="Quantum five-stage method" />
    </div>
  </section>

  <section class="editorial-section" aria-labelledby="industries-title">
    <div class="container">
      <div class="editorial-section__intro">
        <p class="eyebrow">industries</p>
        <div>
          <h2 id="industries-title">Context changes the test.</h2>
          <p>Quantum focuses on four industrial domains where field conditions, systems and implementation constraints matter.</p>
        </div>
      </div>
      <ul class="home-domain-list">
        {PUBLIC_INDUSTRIES.map((industry, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <strong>{industry.name}</strong>
          </li>
        ))}
      </ul>
      <a class="text-link home-section-link" href="/industries/">Explore the industries</a>
    </div>
  </section>

  <section class="editorial-section" aria-labelledby="proof-title">
    <div class="container">
      <article class="proof-feature">
        <img
          class="proof-feature__media"
          src={maradinPoster.src}
          alt={maradinPoster.alt}
          width={maradinPoster.width}
          height={maradinPoster.height}
          loading="lazy"
        />
        <div class="proof-feature__copy">
          <p class="eyebrow">proof</p>
          <h2 id="proof-title">Evidence before scale.</h2>
          <h3 class="proof-feature__title">{maradinProofRecord.title}</h3>
          <p>{maradinProofRecord.summary}</p>
          <a class="text-link" href="/pocs/maradin/">Read the Maradin field record</a>
        </div>
      </article>
    </div>
  </section>

  <section class="editorial-section" aria-labelledby="programmes-title">
    <div class="container">
      <div class="editorial-section__intro">
        <p class="eyebrow">programmes</p>
        <div>
          <h2 id="programmes-title">Structured paths into the field.</h2>
          <p>Programmes create a clear context for industry needs and technologies that are ready to be assessed.</p>
        </div>
      </div>
      <ul class="programme-list">
        <li>
          <span class="programme-list__meta">startup pathway</span>
          <div>
            <h3>{sparkProgramme.name}</h3>
            <p>{sparkProgramme.summary}</p>
          </div>
          <span class="status-pill">{sparkProgramme.status}</span>
        </li>
        <li>
          <span class="programme-list__meta">industry context</span>
          <div>
            <h3>{champProgramme.name}</h3>
            <p>{champProgramme.summary}</p>
          </div>
          <a class="text-link" href="/for-partners/#champ">For industry</a>
        </li>
      </ul>
    </div>
  </section>

  <ClosingCta
    title="Start with the challenge."
    copy="Choose the route that matches where you are entering the work."
  >
    <a class="button button--primary" href="/contact/#for-industry" aria-label="Bring us an industrial challenge">
      <span class="button__label--full">Bring us an industrial challenge</span>
      <span class="button__label--compact" aria-hidden="true">Industry challenge</span>
    </a>
    <a class="button button--secondary" href="/contact/#for-startups" aria-label="Introduce your technology">
      <span class="button__label--full">Introduce your technology</span>
      <span class="button__label--compact" aria-hidden="true">Startup technology</span>
    </a>
    <a class="button button--secondary" href="/contact/#general" aria-label="General or ecosystem contact">
      <span class="button__label--full">General or ecosystem</span>
      <span class="button__label--compact" aria-hidden="true">General contact</span>
    </a>
  </ClosingCta>
</BaseLayout>
