---
import BaseLayout from "../layouts/BaseLayout.astro";
import BuiltWithIndustry from "../components/home/BuiltWithIndustry.astro";
import ConversionField from "../components/home/ConversionField.astro";
import EntryField from "../components/home/EntryField.astro";
import IndustryTerritories from "../components/home/IndustryTerritories.astro";
import MethodField from "../components/home/MethodField.astro";
import ProgrammesField from "../components/home/ProgrammesField.astro";
import ProofField from "../components/home/ProofField.astro";
import {
  PUBLIC_INDUSTRIES,
  champProgramme,
  maradinProofRecord,
  sparkProgramme,
} from "../content";
import "../styles/routes/home.css";
import "../styles/routes/home-cinematic.css";
import "../styles/routes/home-method.css";
import "../styles/routes/home-responsive.css";

const title = "Industrial innovation tested in the real world";
const description =
  "Quantum brings industry and technology together to define real needs, test solutions and turn evidence into decisions.";
const fallbackPosters = {
  desktop: "/media/cinematic/phase-3-dormant-desktop-03f5490ab11a.png",
  portrait: "/media/cinematic/phase-3-dormant-mobile-9d5c19b1a5e2.png",
  landscape: "/media/cinematic/phase-3-dormant-narrow-451d05bcc3d5.png",
} as const;
let cinematicPosters = fallbackPosters;
try {
  const authorities = import.meta.glob(
    "../../artifacts/original/phase-4r2-1-causal-signal-scroll-stability/production/manifests/phase-4r2-production-media-manifest.json",
    { eager: true, query: "?raw", import: "default" },
  );
  const payload = Object.values(authorities)[0];
  if (typeof payload !== "string") throw new Error("final manifest is absent");
  const manifest = JSON.parse(payload) as {
    schema?: string;
    assets?: Array<{ file?: string; kind?: string; family?: string; bytes?: number; sha256?: string }>;
  };
  const posters = Object.fromEntries((manifest.assets ?? [])
    .filter((asset) => asset.kind === "poster" && ["desktop", "portrait", "landscape"].includes(asset.family ?? ""))
    .map((asset) => [asset.family!, `/media/cinematic/phase-4r2/${asset.file}`]));
  if (
    manifest.schema !== "quantum-hub.phase-4-r2.production-media-manifest.v1"
    || Object.keys(posters).length !== 3
    || !["desktop", "portrait", "landscape"].every((family) => typeof posters[family] === "string")
  ) throw new Error("final poster authority is incomplete");
  cinematicPosters = posters as typeof fallbackPosters;
} catch (error) {
  if (import.meta.env.PHASE4R2_FINAL_AUTHORITY === "1") {
    throw new Error(`Phase 4-R2 final authority was required but unavailable: ${error instanceof Error ? error.message : error}`);
  }
}

const processSteps = [
  { title: "Frame", description: "Define the operational problem, owner and success criteria." },
  { title: "Source", description: "Find technologies relevant to the real operating context." },
  { title: "Assess", description: "Evaluate technical, commercial and implementation fit." },
  { title: "Test", description: "Run a structured POC in a real environment." },
  { title: "Decide", description: "Use evidence to determine the next step." },
] as const;

const maradinOpening = maradinProofRecord.media.find(({ id }) => id === "maradin-field-aperture-poster");
const maradinClimax = maradinProofRecord.media.find(({ id }) => id === "maradin-real-field-still");
if (!maradinOpening || !maradinClimax) {
  throw new Error("The approved Maradin stills are required on Home.");
}
---

<BaseLayout
  {title}
  {description}
  bodyClass="home-page"
  skipHref="#entry"
  skipLabel="Skip cinematic intro"
>
  <Fragment slot="head">
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? true;
          const capable =
            "HTMLVideoElement" in window &&
            "ResizeObserver" in window &&
            "requestAnimationFrame" in window;
          const directDeepLink = window.location.hash.length > 1;
          const semanticHomeIntent = window.location.hash === "#entry";
          const initialFamily = window.innerWidth <= 800 && window.innerHeight >= window.innerWidth
            ? "portrait"
            : window.innerWidth <= 900 && window.innerHeight <= 480 && window.innerWidth > window.innerHeight
              ? "landscape"
              : "desktop";
          const initialCohort = initialFamily === "desktop" && window.innerHeight < 704
            ? "short-desktop"
            : initialFamily;
          const restoredState = window.history.state?.quantumHomeCinematic;
          const restoredSettled = restoredState?.version === 4 && restoredState.settledOrLower === true;
          const viewportScale = window.visualViewport?.scale ?? 1;
          const rootFontSize = Number.parseFloat(getComputedStyle(root).fontSize);
          const chromeRatio = window.innerWidth > 0 && window.outerWidth > 0
            ? window.outerWidth / window.innerWidth
            : 1;
          const textZoomUnsafe = rootFontSize >= 30
            || viewportScale >= 1.75
            || (navigator.maxTouchPoints === 0 && window.outerWidth >= 900 && chromeRatio >= 1.65);
          const candidate = capable
            && !reduced
            && (!directDeepLink || semanticHomeIntent)
            && (!restoredSettled || semanticHomeIntent)
            && !textZoomUnsafe;
          const bypassReason = !capable
            ? "capability"
            : reduced
              ? "reduced-motion"
              : directDeepLink && !semanticHomeIntent
                ? "deep-link"
                : restoredSettled && !semanticHomeIntent
                  ? "restored-scroll"
                  : textZoomUnsafe
                    ? "text-zoom"
                    : semanticHomeIntent
                      ? "semantic-entry"
                      : "eligible";

          root.dataset.cinematicEligibility = candidate ? "eligible" : "bypass";
          root.dataset.cinematicMode = candidate ? "candidate" : "static";
          root.dataset.cinematicHeader = candidate ? "concealed" : "released";
          root.dataset.cinematicBootstrap = bypassReason;
          root.dataset.cinematicCohort = initialCohort;
          if (semanticHomeIntent) root.dataset.cinematicEntryIntent = "pending";
          if (candidate) {
            window.__quantumHomeControllerWatchdog = window.setTimeout(() => {
              delete window.__quantumHomeControllerWatchdog;
              if (root.dataset.cinematicMode !== "candidate") return;
              const preserveRunway = window.scrollY !== 0
                || window.location.hash === "#entry"
                || root.dataset.cinematicEntryIntent === "pending";
              root.dataset.cinematicEligibility = "bypass";
              root.dataset.cinematicMode = preserveRunway ? "enhanced" : "static";
              root.dataset.cinematicHeader = "released";
              root.dataset.cinematicFallback = preserveRunway
                ? "controller-timeout-preserve-runway"
                : "controller-timeout";
              delete root.dataset.cinematicEntryIntent;
              document.querySelector(".site-header")?.removeAttribute("inert");
              document.querySelector(".site-footer")?.removeAttribute("inert");
              document.querySelector("#entry")?.removeAttribute("inert");
              document.querySelectorAll("[data-field-section]").forEach((field) => field.removeAttribute("inert"));
              const shell = document.querySelector("[data-cinematic-shell]");
              if (shell instanceof HTMLElement) {
                shell.dataset.cinematicInteractive = "true";
                shell.dataset.routeNavigation = "released";
                shell.dataset.cinematicPhase = "fallback";
                shell.dataset.mediaState = preserveRunway ? "failed-preserve-runway" : "failed";
                if (preserveRunway) shell.dataset.manifestoReveal = "resolved";
              }
            }, 4_000);
          }
        } catch {
          root.dataset.cinematicEligibility = "bypass";
          root.dataset.cinematicMode = "static";
          root.dataset.cinematicHeader = "released";
          root.dataset.cinematicBootstrap = "bootstrap-error";
        }
      })();
    </script>
  </Fragment>

  <div class="cinematic-shell" data-cinematic-shell data-cinematic-interactive="false" data-route-navigation="concealed">
    <div class="cinematic-runway" aria-hidden="true">
      <div class="cinematic-stage" data-cinematic-stage>
        <picture class="cinematic-poster" data-cinematic-poster aria-hidden="true">
          <source
            media="(max-width: 800px) and (orientation: portrait)"
            srcset={cinematicPosters.portrait}
          />
          <source
            media="(max-width: 900px) and (max-height: 480px) and (orientation: landscape)"
            srcset={cinematicPosters.landscape}
          />
          <img
            src={cinematicPosters.desktop}
            width="1920"
            height="1200"
            alt=""
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </picture>
        <video
          class="cinematic-media"
          data-cinematic-media
          aria-hidden="true"
          tabindex="-1"
          muted
          playsinline
          preload="none"
          disablepictureinpicture
        ></video>
        <span class="cinematic-portal-surface" data-cinematic-portal-surface></span>
      </div>
    </div>

    <EntryField />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const shell = document.querySelector("[data-cinematic-shell]");
        const header = document.querySelector(".site-header");
        const footer = document.querySelector(".site-footer");
        const entry = shell?.querySelector("#entry");
        const downstreamFields = document.querySelectorAll("[data-field-section]");
        const concealed = root.dataset.cinematicMode === "candidate"
          && root.dataset.cinematicHeader === "concealed";
        header?.toggleAttribute("inert", concealed);
        footer?.toggleAttribute("inert", concealed);
        entry?.toggleAttribute("inert", concealed);
        downstreamFields.forEach((field) => field.toggleAttribute("inert", concealed));
        if (!concealed && shell) {
          shell.dataset.cinematicInteractive = "true";
          shell.dataset.routeNavigation = "released";
          shell.dataset.cinematicPhase = "fallback";
        }
      })();
    </script>

    <script>
      const root = document.documentElement;
      const watchdogWindow = window as typeof window & { __quantumHomeControllerWatchdog?: number };
      const clearControllerWatchdog = () => {
        const controllerWatchdog = watchdogWindow.__quantumHomeControllerWatchdog;
        if (typeof controllerWatchdog !== "number") return;
        window.clearTimeout(controllerWatchdog);
        delete watchdogWindow.__quantumHomeControllerWatchdog;
      };
      const controllerTimeoutIsTerminal = () => root.dataset.cinematicFallback === "controller-timeout"
        || root.dataset.cinematicFallback === "controller-timeout-preserve-runway";
      root.dataset.cinematicController = "claimed";
      if (root.dataset.cinematicMode === "candidate") {
        void import("../scripts/home-cinematic-integration")
          .then(({ initHomeCinematicIntegration }) => {
            if (controllerTimeoutIsTerminal()) return;
            initHomeCinematicIntegration();
            clearControllerWatchdog();
          })
          .catch(() => {
            clearControllerWatchdog();
            if (controllerTimeoutIsTerminal()) return;
            root.dataset.cinematicMode = "static";
            root.dataset.cinematicFallback = "controller";
            root.dataset.cinematicHeader = "released";
            root.dataset.cinematicEligibility = "bypass";
            delete root.dataset.cinematicEntryIntent;
            document.querySelector(".site-header")?.removeAttribute("inert");
            document.querySelector(".site-footer")?.removeAttribute("inert");
            document.querySelector("#entry")?.removeAttribute("inert");
            document.querySelectorAll("[data-field-section]").forEach((field) => field.removeAttribute("inert"));
            const shell = document.querySelector("[data-cinematic-shell]");
            if (shell instanceof HTMLElement) {
              shell.dataset.cinematicInteractive = "true";
              shell.dataset.routeNavigation = "released";
              shell.dataset.cinematicPhase = "fallback";
            }
          });
      } else clearControllerWatchdog();
    </script>
  </div>

  <BuiltWithIndustry />
  <MethodField steps={processSteps} />
  <IndustryTerritories industries={PUBLIC_INDUSTRIES} />
  <ProofField
    title={maradinProofRecord.title}
    summary={maradinProofRecord.summary}
    execution={maradinProofRecord.execution}
    openingMedia={maradinOpening}
    climaxMedia={maradinClimax}
  />
  <ProgrammesField spark={sparkProgramme} champ={champProgramme} inheritedMedia={maradinClimax} />
  <ConversionField />
</BaseLayout>
