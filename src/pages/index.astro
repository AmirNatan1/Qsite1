---
import BaseLayout from "../layouts/BaseLayout.astro";
import BuiltWithIndustry from "../components/home/BuiltWithIndustry.astro";
import ConversionField from "../components/home/ConversionField.astro";
import EntryField from "../components/home/EntryField.astro";
import IndustryTerritories from "../components/home/IndustryTerritories.astro";
import MethodField from "../components/home/MethodField.astro";
import ProgrammesField from "../components/home/ProgrammesField.astro";
import ProofField from "../components/home/ProofField.astro";
import {
  PUBLIC_INDUSTRIES,
  champProgramme,
  maradinProofRecord,
  sparkProgramme,
} from "../content";
import "../styles/routes/home.css";
import "../styles/routes/home-cinematic.css";
import "../styles/routes/home-method.css";
import "../styles/routes/home-responsive.css";

const title = "Industrial innovation tested in the real world";
const description =
  "Quantum brings industry and technology together to define real needs, test solutions and turn evidence into decisions.";

const processSteps = [
  { title: "Frame", description: "Define the operational problem, owner and success criteria." },
  { title: "Source", description: "Find technologies relevant to the real operating context." },
  { title: "Assess", description: "Evaluate technical, commercial and implementation fit." },
  { title: "Test", description: "Run a structured POC in a real environment." },
  { title: "Decide", description: "Use evidence to determine the next step." },
] as const;

const maradinOpening = maradinProofRecord.media.find(({ id }) => id === "maradin-field-aperture-poster");
const maradinClimax = maradinProofRecord.media.find(({ id }) => id === "maradin-real-field-still");
if (!maradinOpening || !maradinClimax) {
  throw new Error("The approved Maradin stills are required on Home.");
}
---

<BaseLayout
  {title}
  {description}
  bodyClass="home-page"
  skipHref="#entry"
  skipLabel="Skip cinematic intro"
>
  <Fragment slot="head">
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? true;
          const capable =
            "HTMLVideoElement" in window &&
            "ResizeObserver" in window &&
            "requestAnimationFrame" in window;
          const directDeepLink = window.location.hash.length > 1;
          const restoredState = window.history.state?.quantumHomeCinematic;
          const restoredSettled = restoredState?.version === 1 && restoredState.settledOrLower === true;
          const viewportScale = window.visualViewport?.scale ?? 1;
          const rootFontSize = Number.parseFloat(getComputedStyle(root).fontSize);
          const chromeRatio = window.innerWidth > 0 && window.outerWidth > 0
            ? window.outerWidth / window.innerWidth
            : 1;
          const textZoomUnsafe = rootFontSize >= 30
            || viewportScale >= 1.75
            || (navigator.maxTouchPoints === 0 && window.outerWidth >= 900 && chromeRatio >= 1.65);
          const candidate = capable && !reduced && !directDeepLink && !restoredSettled && !textZoomUnsafe;
          const bypassReason = !capable
            ? "capability"
            : reduced
              ? "reduced-motion"
              : directDeepLink
                ? "deep-link"
                : restoredSettled
                  ? "restored-scroll"
                  : textZoomUnsafe
                    ? "text-zoom"
                    : "eligible";

          root.dataset.cinematicEligibility = candidate ? "eligible" : "bypass";
          root.dataset.cinematicMode = candidate ? "candidate" : "static";
          root.dataset.cinematicHeader = candidate ? "concealed" : "released";
          root.dataset.cinematicBootstrap = bypassReason;
        } catch {
          root.dataset.cinematicEligibility = "bypass";
          root.dataset.cinematicMode = "static";
          root.dataset.cinematicHeader = "released";
          root.dataset.cinematicBootstrap = "bootstrap-error";
        }
      })();
    </script>
  </Fragment>

  <div class="cinematic-shell" data-cinematic-shell data-cinematic-interactive="false">
    <div class="cinematic-runway" aria-hidden="true">
      <div class="cinematic-stage" data-cinematic-stage>
        <picture class="cinematic-poster" data-cinematic-poster>
          <source
            media="(max-width: 350px) and (orientation: portrait)"
            srcset="/media/cinematic/phase-3-dormant-narrow-451d05bcc3d5.png"
          />
          <source
            media="(max-width: 800px) and (orientation: portrait), (max-width: 900px) and (max-height: 480px)"
            srcset="/media/cinematic/phase-3-dormant-mobile-9d5c19b1a5e2.png"
          />
          <img
            src="/media/cinematic/phase-3-dormant-desktop-03f5490ab11a.png"
            width="1440"
            height="900"
            alt=""
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </picture>
        <video
          class="cinematic-media"
          data-cinematic-media
          aria-hidden="true"
          tabindex="-1"
          muted
          playsinline
          preload="none"
          disablepictureinpicture
        ></video>
        <span class="cinematic-portal-surface" data-cinematic-portal-surface></span>
      </div>
    </div>

    <EntryField />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const shell = document.querySelector("[data-cinematic-shell]");
        const header = document.querySelector(".site-header");
        const entry = shell?.querySelector("#entry");
        const concealed = root.dataset.cinematicMode === "candidate"
          && root.dataset.cinematicHeader === "concealed";
        header?.toggleAttribute("inert", concealed);
        entry?.toggleAttribute("inert", concealed);
        if (!concealed && shell) {
          shell.dataset.cinematicInteractive = "true";
          shell.dataset.cinematicPhase = "fallback";
        }
      })();
    </script>

    <script>
      const root = document.documentElement;
      if (root.dataset.cinematicMode === "candidate") {
        void import("../scripts/home-cinematic-integration")
          .then(({ initHomeCinematicIntegration }) => initHomeCinematicIntegration())
          .catch(() => {
            root.dataset.cinematicMode = "static";
            root.dataset.cinematicFallback = "controller";
            root.dataset.cinematicHeader = "released";
            root.dataset.cinematicEligibility = "bypass";
            document.querySelector(".site-header")?.removeAttribute("inert");
            document.querySelector("#entry")?.removeAttribute("inert");
            const shell = document.querySelector("[data-cinematic-shell]");
            if (shell instanceof HTMLElement) {
              shell.dataset.cinematicInteractive = "true";
              shell.dataset.cinematicPhase = "fallback";
            }
          });
      }
    </script>
  </div>

  <BuiltWithIndustry />
  <MethodField steps={processSteps} />
  <IndustryTerritories industries={PUBLIC_INDUSTRIES} />
  <ProofField
    title={maradinProofRecord.title}
    summary={maradinProofRecord.summary}
    execution={maradinProofRecord.execution}
    openingMedia={maradinOpening}
    climaxMedia={maradinClimax}
  />
  <ProgrammesField spark={sparkProgramme} champ={champProgramme} inheritedMedia={maradinClimax} />
  <ConversionField />
</BaseLayout>
