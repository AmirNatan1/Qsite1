---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/routes/not-found.css";
import "../styles/routes/standard.css";

const title = "Page not found";
const description = "This Quantum route does not exist.";
---

<BaseLayout {title} {description} noindex bodyClass="not-found-page">
  <section class="not-found section-shell" aria-labelledby="not-found-title">
    <div class="not-found__inner container">
      <p class="not-found__code" aria-hidden="true">404</p>
      <div>
        <p class="eyebrow">signal absent</p>
        <h1 id="not-found-title">This signal goes nowhere.</h1>
        <a class="button button--primary" href="/">Return home</a>
      </div>
    </div>
  </section>
</BaseLayout>
